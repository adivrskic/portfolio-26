# Keys for the chat and the contact form (netlify/functions). Never prefix them with VITE_: they stay
# on the server. In production set them in Netlify (Site configuration → Environment variables); for
# `npm run dev` / `npm run preview`, copy this file to .env.local and fill it in.

# the cube's chat (Claude)
ANTHROPIC_API_KEY=
# optional: another Claude model for the chat
# CHAT_MODEL=claude-sonnet-5-5

# the contact form (Resend)
RESEND_API_KEY=
# optional: where messages go, and the sender (a Resend-verified address or domain)
# CONTACT_TO_EMAIL=
# CONTACT_FROM_EMAIL=Portfolio Contact <hello@yourdomain.com>
